# WordPress core directories (optional if you want to track them)
wp-admin/
wp-includes/

# Uploads
public_html/wp-content/uploads/

# Cache
public_html/wp-content/cache/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Node dependencies (covers/render pipeline)
node_modules/

# IDE files
.vscode/
.idea/

# WordPress config (managed per-environment, never commit production credentials)
public_html/wp-config.php

# Backup, video clips and zip files
backup_*.zip
public_html/wp-content/updraft/
*.zip
*.mp4
